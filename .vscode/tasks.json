{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "build.sh",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles in Debug mode using build.sh (with console)"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "bash",
            "args": [
                "build.sh",
                "release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles in Release mode using build.sh"
        }
    ]
}