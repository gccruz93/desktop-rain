{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "Create release output directory",
            "type": "shell",
            "command": "New-Item -ItemType directory -Path 'build/release' -Force",
            "problemMatcher": []
        },
        {
            "label": "Compile resource file",
            "type": "shell",
            "command": "windres",
            "args": [
                "resources.rc",
                "-o",
                "resources.o"
            ],
            "dependsOn": "Create release output directory",
            "problemMatcher": []
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "g++",
            "args": [
                "-O2",
                "-s",
                "-std=c++23",
                "src/*.cpp",
                "resources.o",
                "-o",
                "build/release/Desktop Rain.exe",
                "-ld2d1",
                "-municode",
                "-mwindows"
            ],
            "group": "build",
            "dependsOn": "Compile resource file",
            "problemMatcher": [
                "$gcc"
            ]
        },
		{
			"label": "Create output directory",
			"type": "shell",
			"command": "New-Item -ItemType directory -Path 'build/debug' -Force",
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "g++",
			"args": [
				"-g",
				"-std=c++23",
				"src/*.cpp",
				"resources.o",
				"-o",
				"build/debug/debug.exe",
				"-ld2d1",
				"-municode"
			],
			"group": "build",
			"dependsOn": ["Create output directory", "Compile resource file"],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "build active file",
			"type": "shell",
			"command": "g++",
			"args": [
				"-g",
				"-std=c++23",
				"'${file}'",
				"-o",
				"'${fileDirname}\\${fileBasenameNoExtension}.exe'",
				"-ld2d1",
				"-municode"
			],
			"group": "build",
			"problemMatcher": [
				"$gcc"
			]
		}
	]
}
